# Copy to .env locally — never commit real values.
#
# Required
# GITHUB_TOKEN=
# GITHUB_OWNER=
# GITHUB_REPO=
# GIT_AUTHOR_NAME=
# GIT_AUTHOR_EMAIL=
# GPG_KEYID=
# GPG_PASSPHRASE=
# GPG_PUBLIC_KEY_FINGERPRINT=
#
# Optional
# GITHUB_BRANCH=main
# HTTP_LISTEN_ADDR=:8080
#
# GPG in Docker: ONE of the following (multiline env is often broken — prefer file or B64)
# GPG_PRIVATE_KEY_ARMORED="-----BEGIN PGP PRIVATE KEY BLOCK-----..."
# GPG_PRIVATE_KEY_ARMORED_B64=<base64 of UTF-8 armored key, single line>
# GPG_PRIVATE_KEY_FILE=/run/secrets/gpg_private.asc
#
# GPG_PROGRAM=/usr/bin/gpg
# GIT_SIGN_COMMITS=true
